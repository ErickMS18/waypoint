# Copy this file to .env (it is git-ignored) and fill in ONE provider.
#   PowerShell:  Copy-Item .env.example .env

# Which LLM provider to use: gemini | anthropic | openai | openai_compatible
LLM_PROVIDER=gemini

# Model name (optional). Defaults per provider are in src/waypoint/llm/factory.py.
# Model names change often: check the provider's docs if you get a 404.
# LLM_MODEL=gemini-3.8-flash

# --- Keys (fill only the one you use) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For openai_compatible (Ollama, Groq, OpenRouter, LM Studio...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# Minimum seconds between LLM calls (useful on free tiers). Default: 0 (4 for gemini).
# LLM_MIN_INTERVAL=4
